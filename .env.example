PORT=3000
# Token que tú eliges; el mismo que pones en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=cambia-esto
# Secreto de la app de Meta, para validar la firma de los mensajes
WHATSAPP_APP_SECRET=
# Token de acceso y número (phone number id) de WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
