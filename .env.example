# --- Panel y simulador (se exponen al navegador; solo valores públicos) ---
# Si se dejan vacíos, el simulador corre en modo demo (todo local, sin servidor).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Solo para scripts locales (scripts/seed-demo.ts). NUNCA con prefijo VITE_ ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Secretos de las Edge Functions (no van en este archivo en producción) ---
#   supabase secrets set ANTHROPIC_API_KEY=...
#   supabase secrets set ANTHROPIC_MODEL=claude-opus-5-5   # opcional
# En local: supabase/functions/.env (ya está en .gitignore)
